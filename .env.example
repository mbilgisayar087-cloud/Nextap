# Supabase (client tarafında kullanılır — VITE_ prefix zorunludur)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public NFC/QR bağlantılarında kullanılacak temel URL (production domaininiz)
VITE_PUBLIC_BASE_URL=https://notingo.example.com

# --- Sadece bilgi amaçlı / opsiyonel ---
# Service Role Key SADECE server-side ortamlarda (ör. bir edge function veya
# CI script'i) kullanılmalı, ASLA frontend'e (.env.local / VITE_*) verilmemeli.
# Bu proje Supabase Auth kullandığı için ayrı bir JWT_SECRET / ADMIN_EMAIL /
# ADMIN_PASSWORD sistemine ihtiyaç yoktur — admin kullanıcıları Supabase Auth
# üzerinden (Dashboard > Authentication > Users) oluşturulur.
# SUPABASE_SERVICE_ROLE_KEY=only-if-you-add-server-side-scripts
